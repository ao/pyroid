# mypy.stubtest allowlist (CI job `stubtest`). Keep it short; justify every entry.

# The stub declares Column as Generic[_T_co] so Column[str] / Column[bool] type-check;
# at runtime the same subscripting is provided by a native __class_getitem__.
pyroid._pyroid.Column.__class_getitem__

# Needs datatrove, which the stubtest venv leaves out: the steps subclass datatrove's untyped classes,
# so mypy sees Any bases and stubtest would report every __init__ and metaclass.
pyroid.integrations.datatrove

# Needs NeMo Curator (CPython 3.11-3.13, with torch and Ray), which the stubtest venv leaves out, for the
# same reason: the stages and filters subclass its untyped classes.
pyroid.integrations.nemo_curator

# A false positive: mypy records the class `_FastText`, defined inside a function, as a public module
# name (`_FastText@<line>`), so the stub-side names never match the runtime __all__.
pyroid.integrations._patch.__all__

# A string-form TypeAlias: the runtime value is the annotation string, mypy sees the Union.
pyroid.integrations.hf.LidModel

# pyroid.nltk's change-counting set and defaultdict: their mutating methods are generated in a loop
# (each bumps a counter, then calls the base method), so mypy sees the base signatures.
pyroid.nltk._punkt._Set\..*
pyroid.nltk._punkt._Ortho\..*

# pyroid.packaging's native classes take any arguments in __new__ (a subclass, or unpickling, makes an
# empty object that __init__ or __setstate__ fills in, as with packaging's object.__new__); the stubs give
# packaging's __init__ signatures.
pyroid.packaging.version.Version.__init__
pyroid.packaging.specifiers.Specifier.__init__
pyroid.packaging.specifiers.SpecifierSet.__init__
pyroid.packaging.markers.Marker.__init__
# PyO3 exposes the reflected slot wrapper of __and__/__or__; it returns NotImplemented, as packaging's
# missing __rand__/__ror__ do.
pyroid.packaging.specifiers.SpecifierSet.__rand__
pyroid.packaging.markers.Marker.__rand__
pyroid.packaging.markers.Marker.__ror__
# context's runtime default is a sentinel, so that an explicit None is "another context" as in packaging;
# the stub shows packaging's default.
pyroid.packaging.markers.Marker.evaluate
# Typing aliases: a Literal (mypy sees a Union) and a NewType, the same objects packaging defines.
pyroid.packaging.markers.EvaluateContext
pyroid.packaging.utils.NormalizedName
# A functools.cache wrapper (mypy sees *args, **kwargs).
pyroid.packaging._compat._cached_default_environment

# pyroid.sqlparse: its private copies of sqlparse 0.6.1's tokens.py, sql.py, keywords.py, lexer.py
# and exceptions.py (used when sqlparse is not installed). Their classes report the public module
# as __module__ (pyroid.sqlparse.tokens, ...), which the untyped sources cannot say.
pyroid.sqlparse._own_.*
# A tuple subclass, as sqlparse defines it; the stub keeps it a plain class.
pyroid.sqlparse.tokens._TokenType
