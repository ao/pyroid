"""jmespath's `Options` and its tree interpreter (`jmespath.visitor`).

`pyroid.jmespath.search` and `ParsedResult.search` evaluate natively. The `TreeInterpreter`
here is jmespath's Python code, for programs that drive the interpreter themselves
(`TreeInterpreter(options).visit(parsed, data)`) or subclass it.
"""

from typing import Any, ClassVar

__all__ = ["GraphvizVisitor", "Options", "TreeInterpreter", "Visitor"]

class Options:
    """Options for evaluating an expression.

    Args:
        dict_cls: The class of the dicts a multi-select hash (`{a: a}`) builds, for example
            `collections.OrderedDict`. `None` means `dict`.
        custom_functions: An instance of a `pyroid.jmespath.functions.Functions` subclass (or of
            jmespath's own `Functions`) with extra `_func_*` functions.
    """

    dict_cls: Any
    custom_functions: Any
    def __init__(self, dict_cls: Any = None, custom_functions: Any = None) -> None: ...

class _Expression:
    expression: Any
    interpreter: Any
    def __init__(self, expression: Any, interpreter: Any) -> None: ...
    def visit(self, node: Any, *args: Any, **kwargs: Any) -> Any: ...

class Visitor:
    """Dispatch `visit(node)` to `visit_<node type>`."""

    def __init__(self) -> None: ...
    def visit(self, node: Any, *args: Any, **kwargs: Any) -> Any:
        """Visit `node`."""

    def default_visit(self, node: Any, *args: Any, **kwargs: Any) -> Any:
        """Called for a node type without a `visit_<type>` method."""

class TreeInterpreter(Visitor):
    """jmespath's interpreter, in Python."""

    COMPARATOR_FUNC: ClassVar[dict[str, Any]]
    MAP_TYPE: ClassVar[type[dict[Any, Any]]]
    def __init__(self, options: Any = None) -> None: ...
    def visit_subexpression(self, node: Any, value: Any) -> Any: ...
    def visit_field(self, node: Any, value: Any) -> Any: ...
    def visit_comparator(self, node: Any, value: Any) -> Any: ...
    def visit_current(self, node: Any, value: Any) -> Any: ...
    def visit_expref(self, node: Any, value: Any) -> Any: ...
    def visit_function_expression(self, node: Any, value: Any) -> Any: ...
    def visit_filter_projection(self, node: Any, value: Any) -> Any: ...
    def visit_flatten(self, node: Any, value: Any) -> Any: ...
    def visit_identity(self, node: Any, value: Any) -> Any: ...
    def visit_index(self, node: Any, value: Any) -> Any: ...
    def visit_index_expression(self, node: Any, value: Any) -> Any: ...
    def visit_slice(self, node: Any, value: Any) -> Any: ...
    def visit_key_val_pair(self, node: Any, value: Any) -> Any: ...
    def visit_literal(self, node: Any, value: Any) -> Any: ...
    def visit_multi_select_dict(self, node: Any, value: Any) -> Any: ...
    def visit_multi_select_list(self, node: Any, value: Any) -> Any: ...
    def visit_or_expression(self, node: Any, value: Any) -> Any: ...
    def visit_and_expression(self, node: Any, value: Any) -> Any: ...
    def visit_not_expression(self, node: Any, value: Any) -> Any: ...
    def visit_pipe(self, node: Any, value: Any) -> Any: ...
    def visit_projection(self, node: Any, value: Any) -> Any: ...
    def visit_value_projection(self, node: Any, value: Any) -> Any: ...

class GraphvizVisitor(Visitor):
    """Render an AST as a Graphviz dot file."""
